<UserControl
    x:Class="AutoLyre.App.Views.LyrePlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:midi="clr-namespace:AutoLyre.Data.Midi;assembly=AutoLyre.Data"
    xmlns:s="https://github.com/canton7/Stylet">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="Phát đàn từ MIDI" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Margin="0,8,0,20" Text="Mở đàn trong Genshin, chọn đúng loại đàn rồi chọn bài."
                       TextWrapping="Wrap" Opacity="0.7" />

            <Label Content="Loại đàn" Target="{Binding ElementName=InstrumentPicker}" Padding="0,0,0,6" />
            <ComboBox x:Name="InstrumentPicker" MinHeight="44" Margin="0,0,0,20" HorizontalAlignment="Stretch"
                      ItemsSource="{x:Static midi:InstrumentProfiles.All}"
                      SelectedItem="{Binding SettingsPage.SelectedProfile}" DisplayMemberPath="DisplayName" />

            <Border Padding="16" CornerRadius="8" Background="{ui:ThemeResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <WrapPanel>
                        <Button Content="Chọn bản nhạc" Command="{s:Action OpenFile}" IsEnabled="{Binding CanChooseFile}"
                                MinHeight="44" Padding="16,8" Margin="0,0,8,8" />
                        <Button Content="Audio → MIDI" Command="{s:Action OpenAudio}" IsEnabled="{Binding CanChooseFile}"
                                MinHeight="44" Padding="16,8" Margin="0,0,0,8" />
                        <Button Content="Lưu MIDI…" Command="{s:Action SaveConvertedMidi}"
                                MinHeight="44" Padding="16,8" Margin="8,0,0,8"
                                ToolTip="Lưu MIDI nhận dạng từ audio, trước khi điều chỉnh theo đàn">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanSaveConvertedMidi}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </WrapPanel>
                    <TextBlock Text="{Binding AudioStatus}" TextWrapping="Wrap" Opacity="0.75">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AudioStatus}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Margin="0,8,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConvertingAudio}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ProgressBar IsIndeterminate="True" Height="4" />
                        <Button Content="Hủy chuyển" Command="{s:Action CancelAudio}"
                                HorizontalAlignment="Left" MinHeight="40" Margin="0,8,0,0" />
                    </StackPanel>
                    <TextBlock Margin="0,16,0,4" FontSize="18" FontWeight="SemiBold"
                               Text="{Binding Playlist.OpenedFile.Title, TargetNullValue=Chưa chọn bài, FallbackValue=Chưa chọn bài}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Playlist.OpenedFile.Path}" />
                    <TextBlock Text="{Binding AnalysisStatus}" TextWrapping="Wrap" Opacity="0.7" />
                </StackPanel>
            </Border>

            <Slider Margin="0,24,0,4" IsMoveToPointEnabled="True" IsEnabled="{Binding CanHitPlayPause}"
                    Value="{Binding SongPosition}" Maximum="{Binding MaximumTime.TotalSeconds}"
                    AutomationProperties.Name="Vị trí phát" />
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding CurrentTime, StringFormat=m\\:ss}" Opacity="0.7" />
                <TextBlock HorizontalAlignment="Right" Text="{Binding MaximumTime, StringFormat=m\\:ss}" Opacity="0.7" />
            </DockPanel>
            <Grid Margin="0,20,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Content="{Binding PlayPauseText}" Command="{s:Action PlayPause}"
                        IsEnabled="{Binding CanHitPlayPause}" MinHeight="48" FontWeight="SemiBold"
                        HorizontalAlignment="Stretch" Appearance="Primary" />
                <Button Grid.Column="1" Margin="12,0,0,0" Content="Dừng" Command="{s:Action Stop}"
                        IsEnabled="{Binding CanHitPlayPause}" MinHeight="48" Padding="24,8" />
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
